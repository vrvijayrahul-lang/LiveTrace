rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidCoordinate(data) {
      return data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0
          && data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0
          && data.accuracy is number && data.accuracy >= 0.0 && data.accuracy <= 100000.0;
    }

    // User profile documents
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tracking sessions collection
    match /trackingSessions/{sessionId} {
      // Public session metadata readable by anyone with the link
      allow read: if true;

      // Session creation
      allow create: if request.resource.data.title is string
                    && request.resource.data.status is string;

      // Session status updates (consent, stopped, revoked)
      allow update: if true;

      // Session deletion
      allow delete: if true;

      // Location subcollection (live coordinate streaming)
      match /location/current {
        allow read: if true;
        allow write: if isValidCoordinate(request.resource.data);
      }
    }
  }
}
