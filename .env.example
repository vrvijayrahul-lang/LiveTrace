# ==============================================================================
# LocateFlow Client Environment Configuration (.env.example)
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are embedded into the client-side
# bundle by Vite at build time. NEVER put Firebase Admin private keys, service
# account secrets, or administrative credentials in this file.
#
# If these variables are left empty, LocateFlow automatically operates in
# "Simulator / Demo Mode", enabling full testing of all interactive maps,
# consent flows, link generation, and real-time updates.
# ==============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
